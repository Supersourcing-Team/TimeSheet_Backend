# ============================================================
# Timesheet Management System – Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# The ONLY value you MUST change before running seed_users.py
# is ADMIN_EMAIL. Everything else has sensible defaults for
# local development.
# ============================================================

# ---------------------------
# App Environment
# ---------------------------
# Set to "production" on Render. Controls cookie security & docs visibility.
ENVIRONMENT=development

# ---------------------------
# Database
# ---------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/timesheet_db

# ---------------------------
# JWT / Security
# ---------------------------
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------
# Google OAuth2
# ---------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here

# ---------------------------
# Default Admin Account
# *** CHANGE THIS to your work email before running seed_users.py ***
# ---------------------------
ADMIN_EMAIL=admin@yourcompany.com

# ---------------------------
# CORS — Allowed Frontend Origins
# On Render, set this to your production Vercel URL as a JSON array:
#   FRONTEND_URLS=["https://your-app.vercel.app"]
# ---------------------------
FRONTEND_URLS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------
# SMTP (for email notifications)
# ---------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@yourcompany.com
SMTP_PASSWORD=your_app_password_here
